 #include <stdio.h>

int main() {
    int operation, a, b;

    printf("operation::1  + >>plus\n");
    printf("operation::2  - >>minus\n");
    printf("operation::3  * >>multiplication\n");
    printf("operation::4  / >>divide\n\n");

    printf("Enter your operation 1,2,3,4:::: ");
    scanf("%d", &operation);

    // Yahan se aapka switch shuru hota hai
    switch(operation) {
        
        case 1: // else if(operation == 1) ki jagah
            printf("Enter 1st number: ");
            scanf("%d", &a);
            printf("Enter 2nd number: ");
            scanf("%d", &b);
            printf("the sum of two numbers is:%d\n", a + b);
            break; // Iske baad switch se bahar nikal jayega

        case 2: // else if(operation == 2) ki jagah
            printf("Enter 1st number: ");
            scanf("%d", &a);
            printf("Enter 2nd number: ");
            scanf("%d", &b);
            printf("the subtraction of two numbers is:%d\n", a - b);
            break;

        case 3: // else if(operation == 3) ki jagah
            printf("Enter 1st number: ");
            scanf("%d", &a);
            printf("Enter 2nd number: ");
            scanf("%d", &b);
            printf("the multiplication of two numbers is:%d\n", a * b);
            break;

        case 4: // else if(operation == 4) ki jagah
            printf("Enter 1st number: ");
            scanf("%d", &a);
            printf("Enter 2nd number: ");
            scanf("%d", &b);
            if(b != 0) {
                printf("Answer is:%d\n", a / b);
                printf("when a divide by b the remainder is:%d\n", a % b);
            } else {
                printf("Error! Division by zero possible nahi hai.\n");
            }
            break;

        default: // Agar user 1,2,3,4 ke alawa kuch aur dale
            printf("Invalid operation choice!\n");
    }

    return 0;
}
